# =============================================================================
# .env.example - CẤU HÌNH DUY NHẤT cho toàn dự án (IP, cổng, tài khoản MQTT)
# Cách dùng:  cp .env.example .env   rồi thay mọi giá trị CHANGE_ME
# Mọi script trong scripts/ đều đọc file này. KHÔNG commit file .env.
# Đổi mạng chỉ cần chạy:  ./scripts/set-network.sh <ip-gateway> [home|laptop|phone]
# =============================================================================

# --- 1. Mạng ---------------------------------------------------------------
# Slot mạng đang dùng: home | laptop | phone (dùng để biết cập nhật biến nào)
ACTIVE_SLOT=phone

# IP của GATEWAY (máy chạy broker LOCAL) trong từng mạng WiFi:
#   home   = WiFi nhà, đặt IP tĩnh thủ công cho laptop
#   laptop = hotspot phát từ laptop (Windows thường cấp 192.168.137.1)
#   phone  = hotspot điện thoại
GATEWAY_IP_HOME=192.168.1.10
GATEWAY_IP_LAPTOP=192.168.137.1
GATEWAY_IP_PHONE=192.168.10.193

# IP gateway ĐANG dùng: dùng cho SAN của cert TLS và cho bridge. set-network.sh tự cập nhật.
GATEWAY_IP=192.168.10.193

# --- 2. Cổng ---------------------------------------------------------------
# Broker LOCAL: thiết bị (ESP32) kết nối vào GATEWAY_IP:LOCAL_PORT
LOCAL_PORT=8883
# Broker SERVER: publish ra host ở SERVER_PORT (trong container vẫn là 8883)
SERVER_PORT=8884
# Địa chỉ broker server mà bridge trỏ tới (2 broker cùng 1 laptop nên = GATEWAY_IP)
SERVER_HOST=192.168.10.193

# --- 3. Chứng chỉ TLS ------------------------------------------------------
# Danh sách IP đưa vào SAN của cert. Cert phải có đúng IP đang dùng,
# nếu không ESP32 và bridge sẽ từ chối kết nối.
CERT_IPS="192.168.10.193 192.168.1.10 192.168.137.1 127.0.0.1"
CERT_DNS="broker-local broker-server"
CERT_DAYS=825

# --- 4. Tài khoản MQTT (đổi hết CHANGE_ME trước khi chạy) ------------------
# Thiết bị trên broker LOCAL (username MQTT = deviceId)
NODE1_PASSWORD=CHANGE_ME_node1
NODE2_PASSWORD=CHANGE_ME_node2
NODE3_PASSWORD=CHANGE_ME_node3
# Tài khoản giám sát/kiểm thử trên broker LOCAL (chỉ đọc, dùng cho MQTTX/smoke-test)
LOCAL_MONITOR_USER=local_monitor
LOCAL_MONITOR_PASSWORD=CHANGE_ME_monitor
# Bridge: broker LOCAL dùng tài khoản này để đăng nhập broker SERVER
BRIDGE_USERNAME=bridge_user
BRIDGE_PASSWORD=CHANGE_ME_bridge
BRIDGE_CLIENT_ID=bridge-local-to-server
# Backend Spring Boot dùng tài khoản này trên broker SERVER
BACKEND_USERNAME=backend_user
BACKEND_PASSWORD=CHANGE_ME_backend

# --- 5. Tên container Docker ----------------------------------------------
# Đổi nếu máy bạn đã có container trùng tên (kiểm tra: docker ps -a).
BROKER_LOCAL_CONTAINER=smarthome-broker-local
BROKER_SERVER_CONTAINER=smarthome-broker-server

# --- 6. PostgreSQL (backend chạy trên host ở Phase 2) -----------------------
# ./scripts/db.sh dùng các biến này để chạy 1 container PostgreSQL 16 cho backend;
# ./scripts/backend.sh đọc lại rồi truyền DB_URL/DB_USER/DB_PASSWORD cho Spring Boot.
# Khi đóng gói Docker (Phase 6) thì server/docker-compose.yml dùng cùng DB_PASSWORD,
# chỉ khác host (postgres thay vì localhost).
DB_CONTAINER=smarthome-postgres
DB_PORT=5432
DB_NAME=smarthome
DB_USER=smarthome
DB_PASSWORD=CHANGE_ME_db

# Cổng HTTP của backend (REST API Phase 3, mặc định 8080 - đúng như docker-compose
# Phase 6 sẽ map 8080:8080). KHÔNG dùng SERVER_PORT cho việc này: SERVER_PORT ở
# trên là cổng TLS của BROKER MQTT, nếu backend đọc nó làm server.port thì sẽ
# tranh chiếm cổng của broker (lỗi "Port 8884 was already in use").
BACKEND_HTTP_PORT=8080

# --- 7. Backend REST + JWT (Phase 3) -----------------------------------------
# Tài khoản admin đăng nhập REST/Swagger. Backend seed lại từ 2 biến này mỗi
# lần khởi động (.env là nguồn chính, hash BCrypt lưu trong bảng users).
# ĐỔI MẬT KHẨU TRƯỚC KHI NỘP BÀI và KHÔNG commit file .env.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_admin
# Khóa ký JWT - tối thiểu 32 ký tự (sinh mới: openssl rand -hex 32)
JWT_SECRET=CHANGE_ME_min32characters_random_hex_string_000000
# Origin của frontend được phép gọi API (CORS) - ngăn cách dấu phẩy, KHÔNG có khoảng trắng.
# Mặc định: dev server Vite (5173) + trang mở từ origin http://localhost (khác cổng).
FRONTEND_ORIGIN=http://localhost:5173,http://localhost
