// =============================================================================
// secrets.h.example - TEMPLATE. Script scripts/gen-secrets.sh sinh ra secrets.h
// cho từng node (node1_sensor/, node2_actuator/) dựa trên file này.
//
// LƯU Ý: file này được #include vào .ino nên comment PHẢI là "//" (không dùng "#"
// hay "/*" ở dòng đầu) - "#" ở đầu dòng bị preprocessor hiểu là chỉ thị -> lỗi
// "invalid preprocessing directive #===" (đã gặp thật khi biên dịch Phase 4).
//
// File secrets.h sinh ra nằm trong .gitignore: KHÔNG commit (có mật khẩu WiFi).
// =============================================================================
#pragma once

// ---- WiFi: ESP32-C3 CHỈ hỗ trợ 2.4 GHz (không thấy mạng 5 GHz) -------------
// Điền SSID/mật khẩu thật vào secrets.h sau khi sinh (script không điền).
// WIFI_NET_COUNT = số hồ sơ mạng bên dưới muốn dùng (1..3).
#define WIFI_NET_COUNT 3
#define SSID_HOME   "TEN_WIFI_NHA"
#define PASS_HOME   "MAT_KHAU_WIFI_NHA"
#define SSID_LAPTOP "TEN_HOTSPOT_LAPTOP"
#define PASS_LAPTOP "MAT_KHAU_HOTSPOT_LAPTOP"
#define SSID_PHONE  "TEN_HOTSPOT_DIEN_THOAI"
#define PASS_PHONE  "MAT_KHAU_HOTSPOT_DIEN_THOAI"

// ---- Broker LOCAL theo từng mạng (gen-secrets.sh tự điền từ .env) ----------
#define MQTT_HOST_HOME   "@MQTT_HOST_HOME@"
#define MQTT_HOST_LAPTOP "@MQTT_HOST_LAPTOP@"
#define MQTT_HOST_PHONE  "@MQTT_HOST_PHONE@"
#define MQTT_PORT 8883

// ---- Danh tính thiết bị ---------------------------------------------------
// DEVICE_ID phải TRÙNG username MQTT và trùng deviceId đã tạo trên backend.
#define DEVICE_ID "@DEVICE_ID@"
#define MQTT_USER DEVICE_ID
#define MQTT_PASS "@MQTT_PASS@"
#define REG_TOKEN "token_lay_tu_backend_khi_dang_ky"   // Phase 3 điền sau

// ---- CA của hệ thống (script chèn nội dung certs/out/ca.crt) ---------------
static const char ROOT_CA[] PROGMEM = R"EOF(
@CA_PEM@
)EOF";